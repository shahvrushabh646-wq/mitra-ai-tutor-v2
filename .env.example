# GEMINI_API_KEY: Required for live Gemini AI tutor responses via @google/genai.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL / MODEL: Optional model override for the AI Provider Adapter.
# Defaults to "gemini-3.8-flash". Supported options: "gemini-3.8-flash", "gemini-flash-latest", "gemini-3.1-flash-lite".
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted (injected automatically at runtime).
APP_URL="MY_APP_URL"

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET: Optional GitHub OAuth credentials
# for syncing study progress, notes, and error logs to GitHub Gists/Repositories.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
